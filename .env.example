# Vite inlines VITE_* values into the bundle at build time: they are public, never secrets.
VITE_API_URL=http://localhost:3000
VITE_APP_ENV=development
VITE_SITE_URL=http://localhost:5173
# Optional. Sentry DSN for browser errors; empty = Sentry off. Its ingest origin must also be
# allowed in the nginx CSP_CONNECT_SRC.
VITE_SENTRY_DSN=
